<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingBottom="16dp">

            <Button
                android:id="@+id/btnBack"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:paddingEnd="8dp"
                android:textSize="18sp"
                android:contentDescription="Back"
                android:text="←" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Online mode"
                android:textSize="19sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Off by default. When you turn this on, your questions go to the API endpoint you configure below instead of the on-device model — nothing is sent anywhere unless you enable it. The key is encrypted on this phone and used only to call that endpoint."
            android:textSize="13.5sp"
            android:textColor="@color/status_text"
            android:lineSpacingExtra="3dp"
            android:paddingBottom="18dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingBottom="16dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Use a cloud model"
                android:textSize="15.5sp" />

            <Switch
                android:id="@+id/switchOnline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <EditText
            android:id="@+id/inputBaseUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Base URL, e.g. https://api.openai.com/v1"
            android:inputType="textUri"
            android:autofillHints="url"
            android:maxLines="1"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <EditText
                android:id="@+id/inputApiKey"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="API key (blank if the endpoint needs none)"
                android:inputType="textPassword"
                android:maxLines="1" />

            <Button
                android:id="@+id/btnToggleKey"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Show"
                android:textSize="13sp"
                android:minWidth="0dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:contentDescription="Show or hide the API key" />
        </LinearLayout>

        <!-- Editable combo box: shows preset picks on tap, but any model
             slug can still be typed (works with any OpenAI-compatible
             endpoint, not just the presets). -->
        <AutoCompleteTextView
            android:id="@+id/inputModel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Model, e.g. deepseek/deepseek-v4-flash"
            android:completionThreshold="0"
            android:maxLines="1"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnTest"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_banner"
            android:textColor="@color/banner_text"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:text="Test connection"
            android:layout_marginBottom="12dp"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_banner"
            android:textColor="@color/banner_text"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:text="Save" />
    </LinearLayout>
</ScrollView>
